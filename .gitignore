# Build output
[Bb]in/
[Oo]bj/
*.pdb

# Visual Studio / Rider / VS Code local state
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/*
!.vscode/extensions.json

# Test / coverage output
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage/

# Local databases and SQLite sidecar files (VenueOS's own attendance.db lives under the Dalamud config
# directory, not this repo, but ignore defensively in case a local one ever ends up here)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Secrets / local environment
*.env
.env.*
*.pfx
*.snk
appsettings.local.json
appsettings.*.local.json

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# Release packaging output — generated by scripts/Package-Release.ps1, never hand-edited or committed;
# repo.json itself (the repository manifest) is tracked release infrastructure and lives at the repo root,
# not under release/.
/release/

# Icon conversion scratch output (the checked-in assets are assets/icon-512.png and assets/icon-64.png,
# produced deliberately by scripts/render-icon.py — this only catches stray intermediates from re-running
# conversion tools elsewhere in the tree)
*.icon-tmp.*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Claude/Codex agent artifacts, if ever created inside the repo instead of the scratchpad
.claude/settings.local.json
